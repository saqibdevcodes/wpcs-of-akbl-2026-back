{
  "compilerOptions": {
    // "rootDir": "./src",
  
     "rootDir": ".",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",

    "types": ["node"],

    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "allowImportingTsExtensions": true,
    "noEmit":false,
    "rewriteRelativeImportExtensions":true
  },
   "include": [
    "src/**/*",
    "generated/**/*"
  ]
}